{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--prefix",
        "client"
      ],
      "port": 4200
    },
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/bin/python",
      "runtimeArgs": [
        "server/run.py"
      ],
      "port": 8000
    }
  ]
}
